[default]
_default:
    just --list

build:
    just -f ../mote-ffi/justfile build-wasm
    npm install
    npm run generate-types

run-dev: build
    npx vite

test: build
    npm run test:run

ci: build
    npm run check
    npm run test:run

ci-build: build
    npm ci
    npm run build
    npm run check

# Build and package the configuration page into a release tarball tracking the
# package.json version. Output: mote-configuration-v<version>.tar.gz
release-package: ci-build
    #!/usr/bin/env bash
    VERSION=$(jq -r .version package.json)
    tar -czf mote-configuration-v${VERSION}.tar.gz -C dist .
