[codespell]
skip = .git,*.lock,package-lock.json,*/node_modules/*,*/build/*,*/dist/*,*/target/*,*/.venv/*,*/book/*,*/styles/*,*/jlcpcb/*,fp-info-cache,ibom.html,*.svg,*.png,*.jpg,*.jpeg,*.pdf,*.woff,*.woff2,*.ttf,*.kicad_pcb,*.kicad_sch,*/theme/*
ignore-words-list = mote,ser,NED
check-hidden = true
